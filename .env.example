# --- Fantrax ---
FANTRAX_LEAGUE_ID=your_league_id_from_url
FANTRAX_TEAM_NAME=Gazdagréti Taxisok
# Optional: skip name lookup (teamId= in the roster page URL)
FANTRAX_TEAM_ID=
# Cookie export (Cookie-Editor JSON, {"name":"value"} dict, or raw "a=b; c=d" header)
FANTRAX_COOKIE_FILE=/etc/fantrax-mcp/fantrax_cookies.json

# --- Season calendar (verify week 1 against Fantrax's schedule page) ---
SEASON_FIRST_DAY=2026-10-06
SEASON_LAST_DAY=2027-04-04
N_WEEKS=25
NHL_SEASON=20262027

# --- Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8765
# Host headers accepted (DNS-rebinding protection stays on)
MCP_ALLOWED_HOSTS=fantrax.example.lan,127.0.0.1:*,localhost:*
# Shared secret checked on every request (mcp-remote sends it as a header)
MCP_AUTH_TOKEN=change-me-long-random-string
